# Copy this file to .env and fill it in. .env is gitignored.
# Then run `uv run fin-agent check`: it tests every setting and says what to fix.

# --- Discord bot --- (setup steps in README.md; not needed for the terminal chat)
# The bot's token. It is a password: never share or commit it.
DISCORD_BOT_TOKEN=
# Your own Discord user ID (a long number). The bot answers only this account.
DISCORD_OWNER_ID=

# --- Google Sheet ---
# The Sheet's link (or ID), and the PATH to a service-account key file.
# The Sheet must be shared with the service account's email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service_account.json
# Used for "today", "this week" and amounts. Currency: EGP or CAD.
TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

# --- Models (served by Ollama) ---
# The chat model. Names ending in "cloud" run on Ollama's servers (sign in to
# Ollama first; nothing to download). For a fully local setup use
# MODEL=qwen3.5:4b after `ollama pull qwen3.5:4b` (slow on a CPU).
MODEL=gemma4:31b-cloud
# The small local model behind long-term memory (`ollama pull qwen3-embedding:0.6b`).
EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_URL=http://127.0.0.1:11434
# Model layers Ollama may put on the GPU. 0 = CPU only, which avoids wrong
# output on Intel integrated GPUs. With an NVIDIA/AMD GPU, -1 lets Ollama decide.
OLLAMA_NUM_GPU=0

# --- Other ---
# Where conversation history, memories and sessions are kept (SQLite files).
# A relative path counts from the project folder. data/ is gitignored.
DATA_DIR=data
# Terminal chat only: the live status line at the bottom (spinner, time,
# tokens). Set to 0 if your terminal shows it wrongly.
LIVE_STATUS=1
# Optional: names that are replaced with [NAME] in redacted text (comma-separated).
REDACT_NAMES=
