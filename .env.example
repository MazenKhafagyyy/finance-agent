# Copy this file to .env and fill it in. .env is gitignored.

# --- Discord bot --- (setup steps in README.md)
# The bot's token. It is a password: never share or commit it.
DISCORD_BOT_TOKEN=
# Your own Discord user ID (a long number). The bot answers only this account.
DISCORD_OWNER_ID=

# --- Google Sheet ---
# The Sheet's link (or ID), and the PATH to a service-account key file.
# The Sheet must be shared with the service account's email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service_account.json
# Used for "today", "this week" and amounts.
TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

# --- Model ---
# The chat model, served by Ollama. Names ending in "cloud" run on Ollama's
# servers (sign in to Ollama first; nothing to download). For a fully local
# setup use MODEL=qwen3.5:4b after `ollama pull qwen3.5:4b` (slow on a CPU).
MODEL=gemma4:31b-cloud
OLLAMA_URL=http://127.0.0.1:11434

# --- Other ---
# Which folder under data/ holds conversation history, memories and sessions.
# "real" is never committed to git; "demo" is handy for trying things out.
MODE=demo
# Terminal chat only: the live status line at the bottom (spinner, time,
# tokens). Set to 0 if your terminal shows it wrongly.
LIVE_STATUS=1
